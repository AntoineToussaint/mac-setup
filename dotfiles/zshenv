# ~/.zshenv — managed by ~/mac-setup
#
# Zsh reads this file for every invocation, including scripts. Keep it limited
# to quiet, dependency-free environment setup; interactive behavior belongs in
# ~/.zshrc and login-shell initialization belongs in ~/.zprofile.

# Ensure repeated shell reloads cannot accumulate duplicate PATH entries. `path`
# is Zsh's array view of PATH; the unique attribute keeps the first occurrence.
typeset -U path PATH
path=(
  "$HOME/.local/bin"       # user-installed CLIs (Claude, Antigravity, etc.)
  "$HOME/.cargo/bin"       # `cargo install` binaries
  "$HOME/go/bin"           # `go install` binaries
  $path
)

# Application-provided CLIs. Only add them on machines where they exist.
[[ -d "/Applications/OrbStack.app/Contents/MacOS/xbin" ]] &&
  path=("/Applications/OrbStack.app/Contents/MacOS/xbin" $path)
[[ -d "$HOME/.lmstudio/bin" ]] && path+=("$HOME/.lmstudio/bin")

export PATH

# Pin `go install` output to a stable directory. mise's Go plugin otherwise
# points GOBIN at the ACTIVE TOOLCHAIN's bin dir
# (~/.local/share/mise/installs/go/<version>/bin). With `go = "latest"` in
# ~/.config/mise/config.toml, every Go release moves that path and silently
# orphans every previously installed binary. ~/go/bin is GOPATH/bin, already on
# PATH above, and is what setup.sh assumes when it installs Go tools.
export GOBIN="$HOME/go/bin"

# Never trust an inherited GOROOT. mise exports GOROOT for the go version that
# was active when a long-lived parent (lazybox daemon, tmux, editor) started;
# after a version bump, child shells then pair the NEW `go` driver from the
# shims with the OLD toolchain, failing with 'compile: version "go1.X" does
# not match go tool version "go1.Y"'. The go driver locates its own GOROOT
# from its binary path, so the export is never needed — interactive shells get
# a fresh, correct one back from `mise activate` in zshrc anyway.
unset GOROOT

export EDITOR=nvim
export VISUAL="$EDITOR"
export PAGER=less
export LESS='-FRX'

# obinctl resolves its coordinate registry relative to the repo you happen to be
# standing in, so it fails from any checkout that is not infra-base. Pin it to the
# stable clone (worktrees under ~/.lazybox come and go; this one does not).
export OBIN_REGISTRY="$HOME/development/obin/infra-base/tools/obin-cli/registry"
