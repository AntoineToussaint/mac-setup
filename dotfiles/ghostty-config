# ~/.config/ghostty/config — managed by ~/mac-setup

font-family = "FiraCode Nerd Font Mono"
font-size = 14
# FiraCode ligatures (!= <= => === ->) render automatically; Ghostty has calt on by default.

theme = "TokyoNight Storm"
# De-purple: replace the magenta ANSI slots with a near-black slate
palette = 5=#414868
palette = 13=#565f89
background-opacity = 0.96
background-blur-radius = 20

window-padding-x = 10
window-padding-y = 10
macos-titlebar-style = "tabs"
# Reopen windows, tabs, splits, and working directories after quitting or rebooting.
window-save-state = always
cursor-style = "bar"
mouse-hide-while-typing = true

# Quick terminal (drop-down) on a global hotkey
keybind = global:cmd+grave_accent=toggle_quick_terminal
