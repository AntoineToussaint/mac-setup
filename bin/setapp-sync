#!/usr/bin/env bash
# ~/mac-setup/bin/setapp-sync — export the Setapp apps you have installed, and
# reinstall them on a fresh Mac.
#
#   setapp-sync export           # write ~/mac-setup/Setappfile from this Mac
#   setapp-sync list             # show what the Setappfile holds, with categories
#   setapp-sync list --missing   # ...only the apps not installed here
#   setapp-sync install          # install what is missing, asking about each app
#   setapp-sync install -y       # ...without asking
#   setapp-sync install -n       # ...print the deeplinks instead of firing them
#   setapp-sync export --prune   # ...and forget the wanted list
#
# Setapp ships no CLI and `brew bundle` cannot see inside a subscription, but
# three undocumented pieces make this work:
#
#   1) The desktop client caches the whole catalogue in a Core Data store at
#      ~/Library/Application Support/Setapp/Default/Databases/Apps.sqlite.
#      ZAPP maps a bundle identifier to the app's public UUID (ZPUBLICID).
#   2) Each app's one-line tagline (ZTAGLINE) and its category — the top-level
#      one from the ZSETAPPCATEGORY many-to-many, plus the finer ZCATEGORYFILTER
#      name — are baked into the Setappfile by `export`, so `install` can say
#      what an app is without the catalogue being present. They are a nicety:
#      the join-table column names carry Core Data entity numbers that can shift
#      between Setapp versions, so a failed lookup leaves them empty rather than
#      failing the export.
#   3) The SetappAgent registers the `setapp:` URL scheme, and its
#      InstallAppFromURL handler accepts `setapp://install?app_id=<UUID>` — the
#      dashed, uppercase form of that same ZPUBLICID. Anything else (numeric
#      ZIDENTIFIER, app_name=, a `launch` host) is rejected as "not a valid
#      install-from-URL link". The handler pops a confirmation panel, downloads
#      the app, and refuses to start a second install while one is running — so
#      `install` goes one app at a time: it asks before each deeplink, then waits
#      for the bundle to land AND stop growing before offering the next one.
#
# The UUIDs are baked into the Setappfile, so restoring does NOT depend on the
# catalogue cache being populated yet on the new Mac — only on Setapp being
# installed and signed in.
#
# Rows are `name<TAB>slug<TAB>app_id<TAB>bundle_id<TAB>category<TAB>tagline`; the
# last two are optional, so a hand-written 4-column row still works.
#
# The Setappfile has two sections. "installed" is regenerated from this Mac on
# every `export`. "wanted" is a wishlist — apps you have decided on but have not
# installed here — and `export` CARRIES IT FORWARD rather than dropping it, so
# hand-added picks survive a re-export. An app moves from wanted to installed by
# itself once it is actually on the machine and you re-export. `install` fetches
# both sections; `export --prune` forgets the wanted list.

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="${SETAPPFILE:-$DIR/Setappfile}"

SETAPP_APP="/Applications/Setapp.app"
SETAPP_APPS="/Applications/Setapp"
CATALOG="$HOME/Library/Application Support/Setapp/Default/Databases/Apps.sqlite"

# How long to wait for one app before asking whether to keep waiting. The wait
# ends as soon as the bundle stops growing, so this only bites when nothing is
# happening at all — a declined panel, or a stalled download.
INSTALL_TIMEOUT="${SETAPP_INSTALL_TIMEOUT:-300}"

log()  { printf "\n\033[1;34m==> %s\033[0m\n" "$*"; }
warn() { printf "\033[1;33m!! %s\033[0m\n" "$*" >&2; }
die()  { printf "\033[1;31mxx %s\033[0m\n" "$*" >&2; exit 1; }

usage() {
  sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# bundle_id_of APP_BUNDLE — CFBundleIdentifier, or empty
bundle_id_of() {
  /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$1/Contents/Info.plist" 2>/dev/null || true
}

# installed_bundle_ids — every bundle id currently under /Applications/Setapp
installed_bundle_ids() {
  [ -d "$SETAPP_APPS" ] || return 0
  local app id
  for app in "$SETAPP_APPS"/*.app; do
    [ -d "$app" ] || continue
    id="$(bundle_id_of "$app")"
    [ -n "$id" ] && printf '%s\n' "$id"
  done
}

# app_path_for BUNDLE_ID — the bundle under /Applications/Setapp with that id
app_path_for() {
  [ -d "$SETAPP_APPS" ] || return 1
  local app
  for app in "$SETAPP_APPS"/*.app; do
    [ -d "$app" ] || continue
    if [ "$(bundle_id_of "$app")" = "$1" ]; then printf '%s\n' "$app"; return 0; fi
  done
  return 1
}

# catalog_meta DB BUNDLE_ID — emit `category<TAB>tagline`, either may be empty.
# Only `export` calls this; see the note at the top about why a miss is not fatal.
catalog_meta() {
  local db="$1" bid top sub tag cat
  bid="$(printf '%s' "$2" | sed "s/'/''/g")"
  top="$(sqlite3 "$db" "
    SELECT c.ZLOCALIZEDNAME FROM ZAPP a
      JOIN Z_1SETAPPCATEGORIES j ON j.Z_1APPLICATIONS = a.Z_PK
      JOIN ZSETAPPCATEGORY c ON c.Z_PK = j.Z_20SETAPPCATEGORIES
     WHERE a.ZBUNDLEIDENTIFIER = '$bid' ORDER BY c.ZPOSITION LIMIT 1;" 2>/dev/null || true)"
  # ZJOINEDFILTERS is a comma-joined list of ZCATEGORYFILTER identifiers; the
  # first one is the app's own shelf ("Web Development", "Menu Bar", ...).
  sub="$(sqlite3 "$db" "
    SELECT f.ZNAME FROM ZAPP a
      JOIN ZCATEGORYFILTER f
        ON f.ZIDENTIFIER = CAST(substr(a.ZJOINEDFILTERS || ',', 1,
                                       instr(a.ZJOINEDFILTERS || ',', ',') - 1) AS INTEGER)
     WHERE a.ZBUNDLEIDENTIFIER = '$bid' LIMIT 1;" 2>/dev/null || true)"
  tag="$(sqlite3 "$db" "
    SELECT ZTAGLINE FROM ZAPP
     WHERE ZBUNDLEIDENTIFIER = '$bid' AND ZTAGLINE IS NOT NULL LIMIT 1;" 2>/dev/null || true)"
  cat="$top"
  if [ -n "$sub" ]; then
    if [ -n "$cat" ]; then cat="$cat / $sub"; else cat="$sub"; fi
  fi
  # Tabs and newlines would corrupt the manifest row.
  printf '%s\t%s\n' "$(printf '%s' "$cat" | tr -d '\t\n')" "$(printf '%s' "$tag" | tr -d '\t\n')"
}

# read_manifest — emit `name<TAB>slug<TAB>uuid<TAB>bundle_id[<TAB>category<TAB>tagline]`,
# comments stripped
read_manifest() {
  [ -f "$MANIFEST" ] || die "no manifest at $MANIFEST — run: setapp-sync export"
  grep -v '^[[:space:]]*#' "$MANIFEST" | grep -v '^[[:space:]]*$'
}

# ---------------------------------------------------------------- export ----
# Setapp keeps Apps.sqlite open in WAL mode, so a live query can miss committed
# pages sitting in -wal. Copy the trio to a temp dir and read that instead.
cmd_export() {
  local prune=0
  case "${1:-}" in --prune) prune=1 ;; esac

  [ -f "$CATALOG" ] || die "Setapp catalogue not found at $CATALOG (open Setapp once and sign in)"
  command -v sqlite3 >/dev/null || die "sqlite3 not found"

  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  cp "$CATALOG" "$tmp/Apps.sqlite"
  cp "$CATALOG-wal" "$tmp/Apps.sqlite-wal" 2>/dev/null || true
  cp "$CATALOG-shm" "$tmp/Apps.sqlite-shm" 2>/dev/null || true

  local ids; ids="$(installed_bundle_ids)"
  [ -n "$ids" ] || die "no apps found under $SETAPP_APPS"

  local rows='' missing='' id row
  while IFS= read -r id; do
    # ZPUBLICID is a raw 16-byte blob; format it as a dashed uppercase UUID.
    row="$(sqlite3 -separator $'\t' "$tmp/Apps.sqlite" "
      SELECT ZNAME, ZSLUG,
             upper(substr(hex(ZPUBLICID),1,8)  || '-' || substr(hex(ZPUBLICID),9,4)  || '-' ||
                   substr(hex(ZPUBLICID),13,4) || '-' || substr(hex(ZPUBLICID),17,4) || '-' ||
                   substr(hex(ZPUBLICID),21,12)),
             ZBUNDLEIDENTIFIER
      FROM ZAPP
      WHERE ZBUNDLEIDENTIFIER = '$(printf '%s' "$id" | sed "s/'/''/g")'
        AND ZPUBLICID IS NOT NULL
      LIMIT 1;")"
    if [ -n "$row" ]; then
      rows+="$row"$'\t'"$(catalog_meta "$tmp/Apps.sqlite" "$id")"$'\n'
    else
      missing+="  $id"$'\n'
    fi
  done <<< "$ids"

  [ -n "$rows" ] || die "none of the installed apps matched the Setapp catalogue"

  # Carry the wishlist forward. Anything already in the manifest that is NOT
  # installed here is a deliberate pick, not stale data — dropping it on every
  # export would make the file impossible to plan a new Mac with. --prune is the
  # way to actually forget one.
  local wanted=''
  if [ "$prune" -eq 0 ] && [ -f "$MANIFEST" ]; then
    local w_name w_slug w_uuid w_bid w_cat w_tag w_meta
    while IFS=$'\t' read -r w_name w_slug w_uuid w_bid w_cat w_tag; do
      [ -n "${w_bid:-}" ] || continue
      grep -qxF "$w_bid" <<< "$ids" && continue
      # Refresh the description from the catalogue — a hand-added pick arrives
      # without one — but keep what the row already had if the lookup misses.
      w_meta="$(catalog_meta "$tmp/Apps.sqlite" "$w_bid")"
      if [ "$w_meta" = $'\t' ]; then w_meta="${w_cat:-}"$'\t'"${w_tag:-}"; fi
      wanted+="$w_name"$'\t'"$w_slug"$'\t'"$w_uuid"$'\t'"$w_bid"$'\t'"$w_meta"$'\n'
    done < <(grep -v '^[[:space:]]*#' "$MANIFEST" | grep -v '^[[:space:]]*$')
  fi

  {
    echo "# Setappfile — the Setapp apps this setup wants."
    echo "#"
    echo "# Regenerate:  setapp-sync export        (--prune to forget the wanted list)"
    echo "# Restore:     setapp-sync install       (needs Setapp installed and signed in)"
    echo "#"
    echo "# name<TAB>slug<TAB>app_id<TAB>bundle_id<TAB>category<TAB>tagline"
    echo "# app_id is the UUID the setapp://install deeplink wants — see bin/setapp-sync."
    echo
    echo "# --- installed on this Mac (regenerated on every export) ---"
    printf '%s' "$rows" | sort -f
    if [ -n "$wanted" ]; then
      echo
      echo "# --- wanted (not installed here; setapp-sync install fetches these too) ---"
      printf '%s' "$wanted" | sort -f
    fi
  } > "$MANIFEST"

  log "Wrote $(printf '%s' "$rows" | grep -c . ) installed + $(printf '%s' "$wanted" | grep -c . || true) wanted to $MANIFEST"
  printf '%s' "$rows" | sort -f | cut -f1 | sed 's/^/  ✓ /'
  [ -n "$wanted" ] && printf '%s' "$wanted" | sort -f | cut -f1 | sed 's/^/    /'
  if [ -n "$missing" ]; then
    warn "not in the catalogue cache (skipped):"
    printf '%s' "$missing" >&2
  fi
}

# ------------------------------------------------------------------ list ----
cmd_list() {
  local only_missing=0
  case "${1:-}" in
    --missing) only_missing=1 ;;
    '') ;;
    *) warn "unknown flag for list: $1"; usage 1 ;;
  esac

  local installed; installed="$(installed_bundle_ids)"
  local name slug uuid bid cat tag mark
  while IFS=$'\t' read -r name slug uuid bid cat tag; do
    [ -n "${bid:-}" ] || continue
    if grep -qxF "$bid" <<< "$installed"; then
      [ "$only_missing" -eq 1 ] && continue
      mark="✓"
    else
      mark=" "
    fi
    printf '%s %-28s \033[2m%s\033[0m\n' "$mark" "$name" "${cat:-—}"
    [ -n "${tag:-}" ] && printf '      %s\n' "$tag"
  done < <(read_manifest)
}

# --------------------------------------------------------------- install ----
# Installs are paced by hand on purpose. The SetappAgent puts up a confirmation
# panel and drops any deeplink fired while another install is in flight, so a
# batch loop silently installs the first app and loses the rest. Here nothing is
# fired until you answer for that app, and the next question does not come up
# until the previous bundle has landed and stopped growing.

ASSUME_YES=0   # raised by -y, by "a" at a prompt, or when there is no terminal
HAVE_TTY=0
[ -e /dev/tty ] && (exec 3</dev/tty) 2>/dev/null && HAVE_TTY=1

# prompt "text" "choices" — read one answer from the terminal, echoed to it too
prompt() {
  local reply
  printf "\033[1;36m??\033[0m %s [%s] " "$1" "$2" > /dev/tty
  IFS= read -r reply < /dev/tty || { printf '\n' > /dev/tty; reply=q; }
  printf '%s' "$reply"
}

# describe_app NAME CATEGORY TAGLINE — the "what is this?" shown before asking
describe_app() {
  printf '\n\033[1m%s\033[0m' "$1"
  if [ -n "${2:-}" ]; then printf '  \033[2m·  %s\033[0m' "$2"; fi
  printf '\n'
  if [ -n "${3:-}" ]; then printf '  %s\n' "$3"; fi
}

# ask_app NAME — 0 install, 1 skip, 2 stop here
ask_app() {
  [ "$ASSUME_YES" -eq 1 ] && return 0
  local reply
  while :; do
    reply="$(prompt "Install $1?" "Y/n/a/q")"
    case "$reply" in
      ''|[yY]|[yY][eE][sS])   return 0 ;;
      [nN]|[nN][oO])          return 1 ;;
      [aA]|[aA][lL][lL])      ASSUME_YES=1; return 0 ;;
      [qQ]|[qQ][uU][iI][tT])  return 2 ;;
      *) printf '   y = install · n = skip · a = install the rest · q = stop\n' > /dev/tty ;;
    esac
  done
}

# wait_for_install BUNDLE_ID NAME — 0 once the bundle is there and has settled
wait_for_install() {
  local bid="$1" name="$2" waited=0 path='' cur prev='' stable=0
  while [ "$waited" -lt "$INSTALL_TIMEOUT" ]; do
    if path="$(app_path_for "$bid")"; then
      # The bundle shows up while the download is still filling it in; treat it
      # as done only once its size holds steady across two polls.
      cur="$(du -sk "$path" 2>/dev/null | cut -f1)"
      if [ -n "$cur" ] && [ "$cur" = "$prev" ]; then
        stable=$((stable + 1))
        [ "$stable" -ge 2 ] && return 0
      else
        stable=0
      fi
      prev="$cur"
    fi
    sleep 3; waited=$((waited + 3))
    [ $((waited % 30)) -eq 0 ] && printf '  still waiting for %s (%ss)\n' "$name" "$waited"
  done
  return 1
}

cmd_install() {
  local dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) dry=1 ;;
      -y|--yes)     ASSUME_YES=1 ;;
      *) warn "unknown flag for install: $1"; usage 1 ;;
    esac
    shift
  done
  [ "$HAVE_TTY" -eq 1 ] || ASSUME_YES=1

  [ -d "$SETAPP_APP" ] || die "Setapp.app not installed — run: brew bundle (Brewfile has cask \"setapp\")"

  # Read the manifest up front: the prompts and the per-app waits both need to
  # run with the loop's stdin free.
  local rows; rows="$(read_manifest)"

  local installed; installed="$(installed_bundle_ids)"
  local name slug uuid bid cat tag reply rc n_done=0 n_skip=0 n_miss=0
  while IFS=$'\t' read -r name slug uuid bid cat tag; do
    [ -n "${bid:-}" ] || continue
    if grep -qxF "$bid" <<< "$installed"; then
      printf '  %-28s already installed\n' "$name"
      continue
    fi
    if [ "$dry" -eq 1 ]; then
      printf '  %-28s setapp://install?app_id=%s\n' "$name" "$uuid"
      continue
    fi

    describe_app "$name" "${cat:-}" "${tag:-}"
    rc=0; ask_app "$name" || rc=$?
    case "$rc" in
      1) printf '  %-28s skipped\n' "$name"; n_skip=$((n_skip + 1)); continue ;;
      2) log "Stopping — run \`setapp-sync install\` again to pick up where you left off"; break ;;
    esac

    log "Installing $name"
    echo "  Setapp will ask you to confirm — accept the panel it puts up."
    open "setapp://install?app_id=$uuid"

    while ! wait_for_install "$bid" "$name"; do
      if [ "$HAVE_TTY" -eq 0 ]; then break; fi
      warn "$name has not landed after ${INSTALL_TIMEOUT}s."
      reply="$(prompt "Keep waiting for $name?" "W/s/q")"
      case "$reply" in
        [sS]|[sS][kK][iI][pP])  break ;;
        [qQ]|[qQ][uU][iI][tT])  die "stopped while waiting for $name" ;;
      esac
    done

    if app_path_for "$bid" >/dev/null; then
      echo "  $name installed."
      n_done=$((n_done + 1))
    else
      warn "$name did not install — do it by hand in Setapp, or re-run."
      n_miss=$((n_miss + 1))
    fi
  done <<< "$rows"

  if [ "$dry" -eq 0 ]; then
    log "$n_done installed, $n_skip skipped, $n_miss missed"
  fi
}

case "${1:-}" in
  export)          shift; cmd_export "$@" ;;
  list|ls)         shift; cmd_list "$@" ;;
  install|restore) shift; cmd_install "$@" ;;
  -h|--help|help|'') usage 0 ;;
  *) warn "unknown command: $1"; usage 1 ;;
esac
