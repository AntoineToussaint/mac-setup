#!/usr/bin/env bash
# ~/mac-setup/bin/setapp-sync — export the Setapp apps you have installed, and
# reinstall them on a fresh Mac.
#
#   setapp-sync export           # write ~/mac-setup/Setappfile from this Mac
#   setapp-sync list             # show what the Setappfile would install
#   setapp-sync install          # install everything in the Setappfile
#   setapp-sync install -n       # ...print the deeplinks instead of firing them
#   setapp-sync export --prune   # ...and forget the wanted list
#
# Setapp ships no CLI and `brew bundle` cannot see inside a subscription, but
# two undocumented pieces make this work:
#
#   1) The desktop client caches the whole catalogue in a Core Data store at
#      ~/Library/Application Support/Setapp/Default/Databases/Apps.sqlite.
#      ZAPP maps a bundle identifier to the app's public UUID (ZPUBLICID).
#   2) The SetappAgent registers the `setapp:` URL scheme, and its
#      InstallAppFromURL handler accepts `setapp://install?app_id=<UUID>` — the
#      dashed, uppercase form of that same ZPUBLICID. Anything else (numeric
#      ZIDENTIFIER, app_name=, a `launch` host) is rejected as "not a valid
#      install-from-URL link". The handler pops a confirmation panel, downloads
#      the app, and refuses to start a second install while one is running — so
#      `install` fires one deeplink at a time and waits for the bundle to land.
#
# The UUIDs are baked into the Setappfile, so restoring does NOT depend on the
# catalogue cache being populated yet on the new Mac — only on Setapp being
# installed and signed in.
#
# The Setappfile has two sections. "installed" is regenerated from this Mac on
# every `export`. "wanted" is a wishlist — apps you have decided on but have not
# installed here — and `export` CARRIES IT FORWARD rather than dropping it, so
# hand-added picks survive a re-export. An app moves from wanted to installed by
# itself once it is actually on the machine and you re-export. `install` fetches
# both sections; `export --prune` forgets the wanted list.

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="${SETAPPFILE:-$DIR/Setappfile}"

SETAPP_APP="/Applications/Setapp.app"
SETAPP_APPS="/Applications/Setapp"
CATALOG="$HOME/Library/Application Support/Setapp/Default/Databases/Apps.sqlite"

# How long to wait for one app to download before giving up and moving on.
INSTALL_TIMEOUT="${SETAPP_INSTALL_TIMEOUT:-600}"

log()  { printf "\n\033[1;34m==> %s\033[0m\n" "$*"; }
warn() { printf "\033[1;33m!! %s\033[0m\n" "$*" >&2; }
die()  { printf "\033[1;31mxx %s\033[0m\n" "$*" >&2; exit 1; }

usage() {
  sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# bundle_id_of APP_BUNDLE — CFBundleIdentifier, or empty
bundle_id_of() {
  /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$1/Contents/Info.plist" 2>/dev/null || true
}

# installed_bundle_ids — every bundle id currently under /Applications/Setapp
installed_bundle_ids() {
  [ -d "$SETAPP_APPS" ] || return 0
  local app id
  for app in "$SETAPP_APPS"/*.app; do
    [ -d "$app" ] || continue
    id="$(bundle_id_of "$app")"
    [ -n "$id" ] && printf '%s\n' "$id"
  done
}

# read_manifest — emit `name<TAB>slug<TAB>uuid<TAB>bundle_id`, comments stripped
read_manifest() {
  [ -f "$MANIFEST" ] || die "no manifest at $MANIFEST — run: setapp-sync export"
  grep -v '^[[:space:]]*#' "$MANIFEST" | grep -v '^[[:space:]]*$'
}

# ---------------------------------------------------------------- export ----
# Setapp keeps Apps.sqlite open in WAL mode, so a live query can miss committed
# pages sitting in -wal. Copy the trio to a temp dir and read that instead.
cmd_export() {
  local prune=0
  case "${1:-}" in --prune) prune=1 ;; esac

  [ -f "$CATALOG" ] || die "Setapp catalogue not found at $CATALOG (open Setapp once and sign in)"
  command -v sqlite3 >/dev/null || die "sqlite3 not found"

  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  cp "$CATALOG" "$tmp/Apps.sqlite"
  cp "$CATALOG-wal" "$tmp/Apps.sqlite-wal" 2>/dev/null || true
  cp "$CATALOG-shm" "$tmp/Apps.sqlite-shm" 2>/dev/null || true

  local ids; ids="$(installed_bundle_ids)"
  [ -n "$ids" ] || die "no apps found under $SETAPP_APPS"

  local rows='' missing='' id row
  while IFS= read -r id; do
    # ZPUBLICID is a raw 16-byte blob; format it as a dashed uppercase UUID.
    row="$(sqlite3 -separator $'\t' "$tmp/Apps.sqlite" "
      SELECT ZNAME, ZSLUG,
             upper(substr(hex(ZPUBLICID),1,8)  || '-' || substr(hex(ZPUBLICID),9,4)  || '-' ||
                   substr(hex(ZPUBLICID),13,4) || '-' || substr(hex(ZPUBLICID),17,4) || '-' ||
                   substr(hex(ZPUBLICID),21,12)),
             ZBUNDLEIDENTIFIER
      FROM ZAPP
      WHERE ZBUNDLEIDENTIFIER = '$(printf '%s' "$id" | sed "s/'/''/g")'
        AND ZPUBLICID IS NOT NULL
      LIMIT 1;")"
    if [ -n "$row" ]; then
      rows+="$row"$'\n'
    else
      missing+="  $id"$'\n'
    fi
  done <<< "$ids"

  [ -n "$rows" ] || die "none of the installed apps matched the Setapp catalogue"

  # Carry the wishlist forward. Anything already in the manifest that is NOT
  # installed here is a deliberate pick, not stale data — dropping it on every
  # export would make the file impossible to plan a new Mac with. --prune is the
  # way to actually forget one.
  local wanted=''
  if [ "$prune" -eq 0 ] && [ -f "$MANIFEST" ]; then
    local w_name w_slug w_uuid w_bid
    while IFS=$'\t' read -r w_name w_slug w_uuid w_bid; do
      [ -n "${w_bid:-}" ] || continue
      grep -qxF "$w_bid" <<< "$ids" && continue
      wanted+="$w_name"$'\t'"$w_slug"$'\t'"$w_uuid"$'\t'"$w_bid"$'\n'
    done < <(grep -v '^[[:space:]]*#' "$MANIFEST" | grep -v '^[[:space:]]*$')
  fi

  {
    echo "# Setappfile — the Setapp apps this setup wants."
    echo "#"
    echo "# Regenerate:  setapp-sync export        (--prune to forget the wanted list)"
    echo "# Restore:     setapp-sync install       (needs Setapp installed and signed in)"
    echo "#"
    echo "# name<TAB>slug<TAB>app_id<TAB>bundle_id"
    echo "# app_id is the UUID the setapp://install deeplink wants — see bin/setapp-sync."
    echo
    echo "# --- installed on this Mac (regenerated on every export) ---"
    printf '%s' "$rows" | sort -f
    if [ -n "$wanted" ]; then
      echo
      echo "# --- wanted (not installed here; setapp-sync install fetches these too) ---"
      printf '%s' "$wanted" | sort -f
    fi
  } > "$MANIFEST"

  log "Wrote $(printf '%s' "$rows" | grep -c . ) installed + $(printf '%s' "$wanted" | grep -c . || true) wanted to $MANIFEST"
  printf '%s' "$rows" | sort -f | cut -f1 | sed 's/^/  ✓ /'
  [ -n "$wanted" ] && printf '%s' "$wanted" | sort -f | cut -f1 | sed 's/^/    /'
  if [ -n "$missing" ]; then
    warn "not in the catalogue cache (skipped):"
    printf '%s' "$missing" >&2
  fi
}

# ------------------------------------------------------------------ list ----
cmd_list() {
  local installed; installed="$(installed_bundle_ids)"
  local name slug uuid bid mark
  while IFS=$'\t' read -r name slug uuid bid; do
    if grep -qxF "$bid" <<< "$installed"; then mark="✓"; else mark=" "; fi
    printf '%s %-28s %s\n' "$mark" "$name" "setapp://install?app_id=$uuid"
  done < <(read_manifest)
}

# --------------------------------------------------------------- install ----
cmd_install() {
  local dry=0
  case "${1:-}" in -n|--dry-run) dry=1 ;; esac

  [ -d "$SETAPP_APP" ] || die "Setapp.app not installed — run: brew bundle (Brewfile has cask \"setapp\")"

  local installed; installed="$(installed_bundle_ids)"
  local name slug uuid bid waited
  while IFS=$'\t' read -r name slug uuid bid; do
    if grep -qxF "$bid" <<< "$installed"; then
      printf '  %-28s already installed\n' "$name"
      continue
    fi
    if [ "$dry" -eq 1 ]; then
      printf '  %-28s setapp://install?app_id=%s\n' "$name" "$uuid"
      continue
    fi

    log "Installing $name"
    echo "  Setapp will ask you to confirm — accept the panel it puts up."
    open "setapp://install?app_id=$uuid"

    # The agent refuses a second install while one is in flight, so wait for the
    # bundle to appear before firing the next deeplink.
    waited=0
    while [ "$waited" -lt "$INSTALL_TIMEOUT" ]; do
      grep -qxF "$bid" <<< "$(installed_bundle_ids)" && break
      sleep 3; waited=$((waited + 3))
    done
    if grep -qxF "$bid" <<< "$(installed_bundle_ids)"; then
      echo "  $name installed."
    else
      warn "$name did not appear within ${INSTALL_TIMEOUT}s — install it by hand or re-run."
    fi
  done < <(read_manifest)
}

case "${1:-}" in
  export)          shift; cmd_export "$@" ;;
  list|ls)         shift; cmd_list "$@" ;;
  install|restore) shift; cmd_install "$@" ;;
  -h|--help|help|'') usage 0 ;;
  *) warn "unknown command: $1"; usage 1 ;;
esac
