#!/usr/bin/env python3
"""Shared-secret gate in front of a local dev server.

Tailscale Funnel is public and anonymous: anyone who learns the *.ts.net URL can
reach whatever is behind it. This sits between Funnel and the real dev server and
rejects any request that does not carry the right token, so a leaked URL alone is
not enough to reach the machine.

Deliberately stdlib-only — it has to start instantly and survive a Python upgrade
without a virtualenv. Sized for CI and development traffic, not production load.

    devtunnel-guard --listen 8099 --upstream 3000     # token from $DEVTUNNEL_TOKEN
"""

from __future__ import annotations

import argparse
import hmac
import os
import sys
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

TOKEN_HEADER = "X-Devtunnel-Token"

# Connection-level headers describe a single hop and must not be relayed onward.
HOP_BY_HOP = frozenset(
    {
        "connection",
        "keep-alive",
        "proxy-authenticate",
        "proxy-authorization",
        "te",
        "trailer",
        "transfer-encoding",
        "upgrade",
    }
)


class GuardHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "devtunnel-guard"

    # Set by main().
    token = ""
    upstream = ""
    verbose = False

    def log_message(self, fmt: str, *args) -> None:  # noqa: A002
        if self.verbose:
            sys.stderr.write("guard: %s\n" % (fmt % args))

    def _authorized(self) -> bool:
        supplied = self.headers.get(TOKEN_HEADER, "")
        # compare_digest keeps the check constant-time; a plain == would leak the
        # token a character at a time to anyone able to measure the response.
        return bool(supplied) and hmac.compare_digest(supplied, self.token)

    def _deny(self) -> None:
        body = b"401 unauthorized: missing or invalid " + TOKEN_HEADER.encode() + b"\n"
        self.send_response(401)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _proxy(self) -> None:
        if not self._authorized():
            self.log_message("denied %s %s", self.command, self.path)
            self._deny()
            return

        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else None

        headers = {
            k: v for k, v in self.headers.items() if k.lower() not in HOP_BY_HOP
        }
        # The token is for this hop only; the dev server never needs to see it.
        # Matched case-insensitively — HTTP header names are not case-sensitive.
        for key in list(headers):
            if key.lower() == TOKEN_HEADER.lower():
                del headers[key]

        request = urllib.request.Request(
            self.upstream + self.path,
            data=body,
            headers=headers,
            method=self.command,
        )

        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                payload = response.read()
                self.send_response(response.status)
                for key, value in response.headers.items():
                    if key.lower() not in HOP_BY_HOP and key.lower() != "content-length":
                        self.send_header(key, value)
                self.send_header("Content-Length", str(len(payload)))
                self.end_headers()
                self.wfile.write(payload)
        except urllib.error.HTTPError as err:
            # A 4xx/5xx from the dev server is a real answer — pass it through
            # rather than masking it as a gateway failure.
            payload = err.read()
            self.send_response(err.code)
            for key, value in err.headers.items():
                if key.lower() not in HOP_BY_HOP and key.lower() != "content-length":
                    self.send_header(key, value)
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
        except (urllib.error.URLError, ConnectionError, TimeoutError) as err:
            message = ("502 upstream %s unreachable: %s\n" % (self.upstream, err)).encode()
            self.send_response(502)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(message)))
            self.end_headers()
            self.wfile.write(message)

    do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = do_OPTIONS = _proxy


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--listen", type=int, required=True, help="port to accept Funnel traffic on")
    parser.add_argument("--upstream", type=int, required=True, help="port the real dev server listens on")
    parser.add_argument(
        "--upstream-host",
        default="localhost",
        help="host the dev server is on (default: localhost, which resolves to "
        "whichever loopback family the server actually bound)",
    )
    parser.add_argument("--verbose", action="store_true", help="log every allow/deny to stderr")
    args = parser.parse_args()

    token = os.environ.get("DEVTUNNEL_TOKEN", "")
    if not token:
        sys.stderr.write("devtunnel-guard: DEVTUNNEL_TOKEN is not set — refusing to run open\n")
        return 2
    if args.listen == args.upstream:
        sys.stderr.write("devtunnel-guard: --listen and --upstream must differ\n")
        return 2

    GuardHandler.token = token
    # By name, not 127.0.0.1: plenty of dev servers bind IPv6 loopback only
    # ([::1]), and a hard-coded IPv4 address cannot reach those at all.
    # socket.create_connection walks every getaddrinfo result, so a name works
    # whichever family the server chose.
    GuardHandler.upstream = "http://%s:%d" % (args.upstream_host, args.upstream)
    GuardHandler.verbose = args.verbose

    # 127.0.0.1, never 0.0.0.0: only Funnel should be able to reach this port.
    server = ThreadingHTTPServer(("127.0.0.1", args.listen), GuardHandler)
    server.daemon_threads = True
    sys.stderr.write(
        "devtunnel-guard: 127.0.0.1:%d -> 127.0.0.1:%d, requiring %s\n"
        % (args.listen, args.upstream, TOKEN_HEADER)
    )
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
