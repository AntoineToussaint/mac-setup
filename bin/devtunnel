#!/bin/zsh
# devtunnel — expose a local dev server on a FIXED public hostname via Cloudflare.
#
# Wraps `cloudflared` named tunnels. Unlike a quick tunnel
# (`cloudflared tunnel --url ...`), which hands out a throwaway
# https://<random-words>.trycloudflare.com on every start, a named tunnel is a
# persistent object with a DNS record you control: the hostname survives
# restarts, reboots, and reinstalls. That is what makes it usable for OAuth
# redirect URIs, webhook endpoints, and mobile clients pinned to one URL.
#
# Requires a domain whose nameservers are on Cloudflare (a "zone"), because the
# fixed part is a CNAME in that zone. Cloudflare's free plan covers this.
#
#   devtunnel login                     # once per machine — browser auth
#   devtunnel up api.example.com 3000   # create if needed, route DNS, run
#   devtunnel run api.example.com       # run an already-created tunnel
#   devtunnel ls                        # what exists, and where it points
#   devtunnel rm api.example.com        # delete the tunnel (DNS record: manual)

emulate -L zsh
setopt EXTENDED_GLOB PIPE_FAIL

readonly VERSION='1.1.0'
readonly CF_DIR="${HOME}/.cloudflared"
# Fallback for the window before first login, when the app has not yet installed
# its /usr/local/bin shim. Overridable only so the tests can point it at nothing;
# never symlink this path elsewhere — see the Tailscale note in setup.sh.
readonly TS_APP_BIN="${DEVTUNNEL_TS_APP_BIN:-/Applications/Tailscale.app/Contents/MacOS/Tailscale}"
# Tailscale only accepts these as the public-facing Funnel port.
readonly -a TS_FUNNEL_PORTS=(443 8443 10000)

readonly STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/devtunnel"
readonly PIN_FILE="$STATE_DIR/funnel-url"   # expected URL, to detect silent drift
readonly TOKEN_FILE="$STATE_DIR/token"      # shared secret the guard enforces
readonly GUARD_PORT="${DEVTUNNEL_GUARD_PORT:-8099}"
readonly GUARD_BIN="${0:A:h}/devtunnel-guard"

die()  { print -u2 -r -- "devtunnel: $*"; exit 1; }
info() { print -r -- $'\033[1;34m==>\033[0m '"$*"; }
warn() { print -u2 -r -- $'\033[1;33m▲\033[0m '"$*"; }

usage() {
  print -r -- 'Usage: devtunnel <command> [args]

Expose a local dev server on a stable public hostname. Two backends:
  * Cloudflare named tunnel — your own domain, needs its zone on Cloudflare.
  * Tailscale Funnel        — a *.ts.net hostname, no domain and no DNS at all.

Cloudflare commands:
  check <hostname>             Is this hostname'"'"'s zone on Cloudflare yet? Run this
                               after moving nameservers, before `up`.
  login                        Authenticate this machine with Cloudflare (once).
  up <hostname> [target]       Create the tunnel and DNS route if missing, then
                               run it. Idempotent — safe to re-run.
  run <hostname>               Run an existing tunnel without touching DNS.
  ls                           List named tunnels and their configured targets.
  rm <hostname>                Delete the tunnel and its local config.
  config <hostname>            Print the generated config file path + contents.

Tailscale Funnel commands:
  funnel <local-port>          Serve localhost:<port> at your stable *.ts.net URL.
        --guard                Require a shared secret (see `token`). Use this for
                               anything CI touches — Funnel itself has no auth.
        --bg                   Detach instead of holding the terminal.
  funnel url                   Print that URL alone — for CI secrets/config.
  funnel pin                   Record today'"'"'s URL; doctor then fails if it drifts.
  funnel status                Show what Funnel is currently serving.
  funnel off                   Stop serving (the hostname stays yours).
  token                        Print the shared secret (generates one if needed).

Target (default 3000):
  3000                         -> http://localhost:3000
  8443/https                   -> https://localhost:8443 (origin cert not verified)
  http://127.0.0.1:5000        -> used verbatim

Options:
  -h, --help                   Show this help
  -v, --version                Show the version

Notes:
  * The hostname must be inside a zone on your Cloudflare account.
  * `up` uses --overwrite-dns, so it reclaims a hostname pointed elsewhere.
  * `rm` deletes the tunnel; Cloudflare leaves the CNAME behind. Remove it in
    the dashboard (DNS -> Records) if you want the name fully released.
  * Funnel is PUBLIC and unauthenticated, and only serves on ports 443, 8443,
    and 10000 publicly. Put your own auth (a shared secret header, signed
    webhook payloads) in front of anything CI posts to it.'
}

require_cloudflared() {
  command -v cloudflared >/dev/null 2>&1 \
    || die 'cloudflared not installed — run: brew install cloudflared'
}

# cert.pem is Cloudflare's per-account origin certificate; it is what authorizes
# creating a tunnel and writing the DNS record, so nothing works without it.
require_login() {
  [[ -f "$CF_DIR/cert.pem" ]] \
    || die 'not authenticated — run: devtunnel login'
}

# Reject bad names here rather than after a round trip: Cloudflare's error for a
# malformed record is far less obvious than "invalid hostname".
check_hostname() { # check_hostname <hostname>
  local h="$1" label
  [[ -n "$h" ]] || die 'missing <hostname>'
  [[ "$h" == *.* ]] || die "not a fully qualified hostname: $h (use dev.yourdomain.com)"
  (( ${#h} <= 253 )) || die "hostname too long: $h"

  # Per-label rules: 1-63 chars, alphanumeric ends, hyphens only inside.
  for label in "${(@s:.:)h}"; do
    [[ -n "$label" ]] && (( ${#label} <= 63 )) || die "invalid hostname: $h"
    [[ "$label" == [a-zA-Z0-9] || "$label" == [a-zA-Z0-9][a-zA-Z0-9-]#[a-zA-Z0-9] ]] \
      || die "invalid hostname: $h"
  done
}

# One tunnel per hostname keeps `rm` unambiguous and lets several projects run
# side by side. Dots become dashes because tunnel names disallow them.
tunnel_name() { # tunnel_name <hostname>
  print -r -- "dev-${1//./-}"
}

config_path() { # config_path <hostname>
  print -r -- "$CF_DIR/$(tunnel_name "$1").yml"
}

# Resolve the local target shorthand into a service URL for the ingress rule.
service_url() { # service_url <target>
  local target="${1:-3000}"
  case "$target" in
    <->)          print -r -- "http://localhost:$target" ;;
    <->/https)    print -r -- "https://localhost:${target%%/*}" ;;
    http://*|https://*|unix:*|tcp://*|ssh://*|rdp://*)
                  print -r -- "$target" ;;
    *) die "unrecognized target: $target (use a port, PORT/https, or a URL)" ;;
  esac
}

tunnel_id() { # tunnel_id <name> — empty output when the tunnel does not exist
  # Two shapes to survive: an account with no tunnels yields `null` rather than
  # `[]`, and a live tunnel carries the zero timestamp "0001-01-01T00:00:00Z"
  # in deleted_at rather than null. Testing `== null` matches neither.
  cloudflared tunnel list --output json 2>/dev/null \
    | jq -r --arg n "$1" '
        (. // [])[]
        | select(.name == $n)
        | select((.deleted_at // "0001-01-01") | startswith("0001-01-01"))
        | .id' \
    | head -1
}

write_config() { # write_config <hostname> <tunnel-id> <service-url>
  local hostname="$1" id="$2" service="$3" cfg
  cfg="$(config_path "$hostname")"

  # noTLSVerify only for https origins: dev servers almost always present a
  # self-signed cert, which cloudflared would otherwise reject.
  local origin=''
  [[ "$service" == https://* ]] && origin=$'    originRequest:\n      noTLSVerify: true\n'

  cat > "$cfg" <<EOF
# Generated by devtunnel — edits are overwritten by 'devtunnel up'.
tunnel: $id
credentials-file: $CF_DIR/$id.json

ingress:
  - hostname: $hostname
    service: $service
$origin  - service: http_status:404
EOF
  print -r -- "$cfg"
}

# Find the zone apex by walking from the longest suffix down: the first name
# that answers NS is the delegation point. Going longest-first matters for
# multi-part suffixes — shortest-first would stop at co.uk and report Nominet.
cmd_check() {
  local hostname="$1"
  check_hostname "$hostname"
  command -v dig >/dev/null 2>&1 || die 'dig not available'

  local -a labels
  labels=("${(@s:.:)hostname}")

  local zone='' ns='' candidate
  integer i
  for (( i = 1; i <= ${#labels} - 1; i++ )); do
    candidate="${(j:.:)labels[i,-1]}"
    ns="$(dig +short +time=3 +tries=2 NS "$candidate" 2>/dev/null)"
    if [[ -n "$ns" ]]; then zone="$candidate"; break; fi
  done

  if [[ -z "$zone" ]]; then
    die "no nameservers found for $hostname — is the domain registered and resolving?"
  fi

  info "zone: $zone"
  print -r -- 'nameservers:'
  print -r -- "$ns" | sed 's/^/  /'
  print -r -- ''

  # Customer zones get <name>.ns.cloudflare.com; Cloudflare's own zones use
  # ns<N>.cloudflare.com. Match any nameserver under cloudflare.com to cover both.
  if print -r -- "$ns" | grep -qi '\.cloudflare\.com\.\?$'; then
    info "$zone is on Cloudflare — you can run: devtunnel up $hostname <port>"
    [[ -f "$CF_DIR/cert.pem" ]] || warn 'authenticate first: devtunnel login'
    return 0
  fi

  warn "$zone is NOT on Cloudflare yet — a named tunnel cannot route $hostname"
  print -r -- 'To fix: add the domain at https://dash.cloudflare.com (free plan),
then replace the nameservers at your registrar with the pair Cloudflare shows.
Propagation is usually minutes to a few hours; re-run this command until it
reports Cloudflare, then run: devtunnel up '"$hostname"' <port>'
  return 1
}

# ---------- Tailscale Funnel backend -----------------------------------------
# No domain and no DNS: the hostname is derived from the machine and tailnet
# names, so it is stable until you rename either. Unlike `tailscale serve`
# (tailnet-only), Funnel is reachable by anyone on the internet — which is what
# makes it usable from GitHub-hosted CI runners, and why it needs its own auth.

tailscale_bin() {
  if command -v tailscale >/dev/null 2>&1; then
    print -r -- 'tailscale'
  elif [[ -x "$TS_APP_BIN" ]]; then
    print -r -- "$TS_APP_BIN"
  else
    die 'tailscale not installed — run: brew install --cask tailscale-app'
  fi
}

funnel_hostname() { # funnel_hostname <tailscale-bin>
  command -v jq >/dev/null 2>&1 || die 'jq not installed — run: brew install jq'

  # Not named `status` — zsh reserves that as a read-only alias for $?.
  local json state name
  json="$("$1" status --json 2>/dev/null)" \
    || die 'cannot reach the Tailscale daemon — is the app running?'

  state="$(print -r -- "$json" | jq -r '.BackendState // empty')"
  [[ "$state" == 'Running' ]] \
    || die "Tailscale is not connected (state: ${state:-unknown}) — open the app and log in"

  # DNSName is fully qualified with a trailing dot: machine.tailnet.ts.net.
  name="$(print -r -- "$json" | jq -r '.Self.DNSName // empty')"
  [[ -n "$name" ]] || die 'could not read this machine'"'"'s tailnet hostname'
  print -r -- "${name%.}"
}

# The URL is <device>.<tailnet>.ts.net. The tailnet half is stable, but the
# device half tracks the macOS hostname and gains a "-1" suffix if the machine
# is ever re-registered while the old node still exists — either silently breaks
# whatever CI has stored. Pinning turns that into a visible failure.
ensure_token() {
  if [[ -n "${DEVTUNNEL_TOKEN:-}" ]]; then
    print -r -- "$DEVTUNNEL_TOKEN"
    return 0
  fi
  if [[ ! -s "$TOKEN_FILE" ]]; then
    mkdir -p "$STATE_DIR"
    # 32 bytes of urandom, hex-encoded. head -c avoids any shell mangling.
    head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$TOKEN_FILE" \
      || die 'could not generate a token'
    chmod 600 "$TOKEN_FILE"
    warn "generated a new shared secret in $TOKEN_FILE"
  fi
  print -r -- "$(<"$TOKEN_FILE")"
}

cmd_token() {
  local token
  token="$(ensure_token)" || return 1
  print -r -- "$token"
}

cmd_funnel() {
  local sub="${1:-}" ts
  ts="$(tailscale_bin)" || return 1

  case "$sub" in
    pin)
      local host
      host="$(funnel_hostname "$ts")" || return 1
      mkdir -p "$STATE_DIR"
      print -r -- "https://$host" > "$PIN_FILE"
      info "pinned https://$host"
      print -r -- "doctor.sh will now fail if this URL ever changes."
      ;;
    url)
      # Resolve first: `die` inside $(...) exits only the subshell, so inlining
      # this would print a truncated "https://" and still report success.
      local host
      host="$(funnel_hostname "$ts")" || return 1
      # Drift goes to stderr so stdout stays clean for  URL=$(devtunnel funnel url)
      if [[ -s "$PIN_FILE" && "$(<"$PIN_FILE")" != "https://$host" ]]; then
        warn "URL CHANGED — pinned $(<"$PIN_FILE"), now https://$host"
        warn 'update the CI secret, then re-pin with: devtunnel funnel pin'
      fi
      # Deliberately bare so CI can capture it:  URL=$(devtunnel funnel url)
      print -r -- "https://$host"
      ;;
    status)
      "$ts" funnel status
      ;;
    off)
      "$ts" funnel --https=443 off && info 'funnel stopped (the hostname stays yours)'
      # A detached guard outlives the shell that started it, so stop it here too
      # rather than leaving an orphan holding the port.
      if [[ -s "$STATE_DIR/guard.pid" ]]; then
        local pid; pid="$(<"$STATE_DIR/guard.pid")"
        if kill "$pid" 2>/dev/null; then info "stopped the guard (pid $pid)"; fi
        command rm -f -- "$STATE_DIR/guard.pid"
      fi
      ;;
    '')
      die 'usage: devtunnel funnel <local-port> [--guard] [--bg] | url | pin | status | off'
      ;;
    <->)
      (( sub >= 1 && sub <= 65535 )) || die "port out of range: $sub"
      shift

      local guard=0 host
      local -a ts_flags
      while (( $# )); do
        case "$1" in
          --guard) guard=1 ;;
          --bg)    ts_flags+=('--bg') ;;
          *)       die "unrecognized flag: $1 (expected --guard or --bg)" ;;
        esac
        shift
      done

      host="$(funnel_hostname "$ts")" || return 1
      if [[ -s "$PIN_FILE" && "$(<"$PIN_FILE")" != "https://$host" ]]; then
        warn "URL CHANGED — pinned $(<"$PIN_FILE"), now https://$host"
      fi

      if (( guard == 0 )); then
        info "https://$host  ->  http://localhost:$sub"
        warn 'Funnel is PUBLIC and unauthenticated — anyone with the URL can reach this port'
        warn 'add the shared-secret gate with: devtunnel funnel '"$sub"' --guard'
        # "localhost:PORT", not a bare port: tailscale turns a bare port into the
        # IPv4 literal 127.0.0.1, which cannot reach a server bound to [::1] only
        # — a very common default. The name lets it try both families.
        exec "$ts" funnel "${ts_flags[@]}" "localhost:$sub"
      fi

      # Guarded: Funnel points at the gate, the gate forwards only authenticated
      # requests to the real server. Deliberately not exec'd — this shell has to
      # survive to tear the gate back down.
      [[ -x "$GUARD_BIN" ]] || die "guard not found at $GUARD_BIN"
      (( GUARD_PORT != sub )) || die "guard port $GUARD_PORT collides with the app port — set DEVTUNNEL_GUARD_PORT"

      local token
      token="$(ensure_token)" || return 1

      local guard_pid
      if (( ${ts_flags[(I)--bg]} )); then
        # Detached: tailscale returns immediately, so an EXIT trap would kill the
        # gate the instant this shell ends and leave Funnel pointing at a dead
        # port. Outlive the shell instead, and record the pid for `funnel off`.
        mkdir -p "$STATE_DIR"
        DEVTUNNEL_TOKEN="$token" nohup "$GUARD_BIN" \
          --listen "$GUARD_PORT" --upstream "$sub" >/dev/null 2>&1 &
        guard_pid=$!
        print -r -- "$guard_pid" > "$STATE_DIR/guard.pid"
        disown 2>/dev/null || true
      else
        DEVTUNNEL_TOKEN="$token" "$GUARD_BIN" --listen "$GUARD_PORT" --upstream "$sub" &
        guard_pid=$!
        trap 'kill '"$guard_pid"' 2>/dev/null' EXIT INT TERM
      fi

      # Wait for the gate to accept connections before exposing it publicly.
      integer waited=0
      until curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$GUARD_PORT/" 2>/dev/null; do
        (( waited++ >= 50 )) && die 'guard did not start'
        kill -0 "$guard_pid" 2>/dev/null || die 'guard exited during startup'
        sleep 0.1
      done

      info "https://$host  ->  guard :$GUARD_PORT  ->  http://localhost:$sub"
      info "requests must send  X-Devtunnel-Token: $token"
      "$ts" funnel "${ts_flags[@]}" "$GUARD_PORT"
      ;;
    *)
      die "unrecognized argument: $sub (expected a local port, or url/pin/status/off)"
      ;;
  esac
}

cmd_login() {
  require_cloudflared
  if [[ -f "$CF_DIR/cert.pem" ]]; then
    info "already authenticated ($CF_DIR/cert.pem)"
    print -r -- 'Re-run cloudflared tunnel login manually to switch accounts.'
    return 0
  fi
  info 'opening a browser to authorize this machine with Cloudflare'
  cloudflared tunnel login
}

cmd_up() {
  local hostname="$1" target="${2:-3000}"
  check_hostname "$hostname"
  require_cloudflared
  require_login
  command -v jq >/dev/null 2>&1 || die 'jq not installed — run: brew install jq'

  local name id service
  name="$(tunnel_name "$hostname")"
  service="$(service_url "$target")" || return 1

  id="$(tunnel_id "$name")"
  if [[ -z "$id" ]]; then
    info "creating tunnel $name"
    cloudflared tunnel create "$name" >/dev/null || die "could not create tunnel $name"
    id="$(tunnel_id "$name")"
    [[ -n "$id" ]] || die "tunnel $name was created but is not listed"
  else
    info "reusing tunnel $name ($id)"
  fi

  # Routing is idempotent in practice, but the CNAME can drift if the hostname
  # was pointed at something else; --overwrite-dns makes `up` authoritative.
  info "routing https://$hostname -> $service"
  cloudflared tunnel route dns --overwrite-dns "$name" "$hostname" >/dev/null \
    || die "could not create the DNS route for $hostname (is its zone on this Cloudflare account?)"

  local cfg
  cfg="$(write_config "$hostname" "$id" "$service")"

  info "https://$hostname is live while this runs (Ctrl-C to stop)"
  exec cloudflared tunnel --config "$cfg" run "$name"
}

cmd_run() {
  local hostname="$1"
  check_hostname "$hostname"
  require_cloudflared

  local cfg name
  cfg="$(config_path "$hostname")"
  name="$(tunnel_name "$hostname")"
  [[ -f "$cfg" ]] || die "no tunnel configured for $hostname — run: devtunnel up $hostname <port>"

  info "https://$hostname (Ctrl-C to stop)"
  exec cloudflared tunnel --config "$cfg" run "$name"
}

cmd_ls() {
  require_cloudflared
  require_login

  local -a configs
  configs=("$CF_DIR"/dev-*.yml(N))
  if (( ${#configs} == 0 )); then
    print -r -- 'No devtunnel tunnels configured. Create one with: devtunnel up <hostname> <port>'
  else
    printf '%-34s %-28s %s\n' HOSTNAME TARGET CONFIG
    local cfg host svc
    for cfg in "${configs[@]}"; do
      host="$(sed -n 's/^  - hostname: //p' "$cfg" | head -1)"
      svc="$(sed -n 's/^    service: //p' "$cfg" | head -1)"
      printf '%-34s %-28s %s\n' "${host:-?}" "${svc:-?}" "${cfg:t}"
    done
  fi

  print -r -- ''
  info 'all named tunnels on this Cloudflare account'
  cloudflared tunnel list
}

cmd_rm() {
  local hostname="$1"
  check_hostname "$hostname"
  require_cloudflared
  require_login
  command -v jq >/dev/null 2>&1 || die 'jq not installed — run: brew install jq'

  local name id cfg
  name="$(tunnel_name "$hostname")"
  cfg="$(config_path "$hostname")"
  id="$(tunnel_id "$name")"

  if [[ -n "$id" ]]; then
    info "deleting tunnel $name ($id)"
    cloudflared tunnel delete "$name" || die "could not delete $name (still running?)"
  else
    warn "no tunnel named $name on this account"
  fi

  [[ -f "$cfg" ]] && command rm -f -- "$cfg" && info "removed ${cfg:t}"
  warn "the CNAME for $hostname stays until you delete it in the Cloudflare dashboard"
}

cmd_config() {
  local hostname="$1" cfg
  check_hostname "$hostname"
  cfg="$(config_path "$hostname")"
  [[ -f "$cfg" ]] || die "no config for $hostname"
  print -r -- "$cfg"
  print -r -- ''
  cat "$cfg"
}

main() {
  case "${1:-}" in
    -h|--help|help|'') usage; return 0 ;;
    -v|--version)      print -r -- "devtunnel $VERSION"; return 0 ;;
  esac

  local cmd="$1"; shift
  case "$cmd" in
    check)  cmd_check "$@" ;;
    funnel) cmd_funnel "$@" ;;
    token)  cmd_token "$@" ;;
    login)  cmd_login "$@" ;;
    up)     cmd_up "$@" ;;
    run)    cmd_run "$@" ;;
    ls|list) cmd_ls "$@" ;;
    rm|delete) cmd_rm "$@" ;;
    config) cmd_config "$@" ;;
    *) print -u2 -r -- "devtunnel: unknown command: $cmd"; print -u2 -r -- ''; usage >&2; return 2 ;;
  esac
}

main "$@"
